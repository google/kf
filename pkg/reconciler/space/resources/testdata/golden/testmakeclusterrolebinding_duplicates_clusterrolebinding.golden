    },
    "subjects": [
        {
            "kind": "Group",
            "name": "group@example.com"
        },
        {
            "kind": "ServiceAccount",
            "name": "sa.test",
            "namespace": "other"
        },
        {
            "kind": "ServiceAccount",
            "name": "sa.test",
            "namespace": "test"
        },
        {
            "kind": "User",
            "name": "someone@example.com"
        }
    ],
    "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "ClusterRole",
        "name": "space-manager"
    }
}