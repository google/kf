{
    "metadata": {
        "name": "test-space-manager",
        "namespace": "test",
        "labels": {
            "app.kubernetes.io/managed-by": "kf"
        },
        "ownerReferences": [
            {
                "apiVersion": "kf.dev/v1alpha1",
                "kind": "Space",
                "name": "test",
                "uid": "",
                "controller": true,
                "blockOwnerDeletion": true
